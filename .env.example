# OtterWiki Custom Branding Configuration
# Copy this file to .env and customize the values below.
# All values are optional - defaults will be used if not set.

# =============================================================================
# BRANDING OPTIONS
# =============================================================================

# Nav title - displayed in the navbar next to the small logo
# Default: "An Otter Wiki"
SITE_NAME=My Wiki

# Small logo - displayed in the navbar (nav bar logo)
# Can be a URL or path to an attachment (e.g., /Home/a/logo.png)
# Default: Built-in otter head image
SITE_LOGO=https://example.com/nav-logo.png

# Favicon - browser tab icon
# Can be a URL or path to an attachment (e.g., /Home/a/favicon.png)
# Default: Built-in otter favicon
SITE_ICON=https://example.com/favicon.png

# Sidebar title - text displayed below the big logo in the sidebar
# Falls back to SITE_NAME if not set
# Default: "An Otter Wiki"
SIDEBAR_TITLE=My Wiki

# Big logo - displayed at the bottom of the sidebar
# Can be a URL or path to an attachment (e.g., /Home/a/sidebar-logo.png)
# Default: Built-in otter image
SIDEBAR_LOGO=https://example.com/sidebar-logo.png
